{
  "expo": {
    "name": "ICMS",
    "slug": "icms-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "icms",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.icms.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#075C4B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.icms.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#075C4B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A1D30",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ICMS to select cattle photos for marketplace listings.",
          "cameraPermission": "Allow ICMS to take cattle photos for marketplace listings.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ]
  }
}
