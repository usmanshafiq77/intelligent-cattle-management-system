{
  "name": "icms-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist/web",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "check:api": "node --env-file-if-exists=.env scripts/check-api.mjs",
    "check:dependencies": "expo install --check",
    "doctor": "expo-doctor",
    "test:structure": "node --test tests/project-structure.test.mjs tests/design-tokens.test.mjs",
    "test:ui": "jest --runInBand",
    "test": "npm run test:structure && npm run test:ui",
    "validate": "npm run test && npm run check:dependencies && npm run doctor"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "^19.2.3"
  },
  "private": true
}
