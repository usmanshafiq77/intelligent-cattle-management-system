# Public, nonsecret frontend configuration only. Never place tokens, database
# credentials, JWT secrets, private keys, or privileged values in EXPO_PUBLIC_*.
EXPO_PUBLIC_APP_ENV=development

# Fallback used when a platform-specific value below is absent. For a physical
# Android device, replace this with the development computer's reachable LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8000

# Expo web running on the same development computer.
EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:8000

# Android Studio emulator host alias. Replace with the computer's LAN IP when
# running Expo Go on a physical Android device.
EXPO_PUBLIC_API_BASE_URL_ANDROID=http://10.0.2.2:8000

# Safe request metadata only; authorization and payload values are never logged.
EXPO_PUBLIC_API_DEBUG=true
