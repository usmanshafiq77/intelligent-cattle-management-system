DB_HOST=localhost
DB_PORT=5432
DB_NAME=icms_db
DB_USER=icms_app
DB_PASSWORD=
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_ENV=development
# JSON list of explicit browser origins; native mobile requests do not use CORS.
CORS_ALLOWED_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
AUTH_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_REQUESTS=3
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
VERIFICATION_RESEND_RATE_LIMIT_REQUESTS=3
VERIFICATION_RESEND_RATE_LIMIT_WINDOW_SECONDS=3600
FORGOT_PASSWORD_RATE_LIMIT_REQUESTS=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_RATE_LIMIT_REQUESTS=10
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_KEYS=10000
EMAIL_DELIVERY_MODE=console
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_PUBLIC_URL=http://localhost:8081
# Optional per-action overrides. Leave blank to derive them from FRONTEND_PUBLIC_URL.
EMAIL_VERIFICATION_BASE_URL=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20
PASSWORD_RESET_BASE_URL=
INVITATION_ACCEPT_BASE_URL=
# Production SMTP example. Brevo uses smtp-relay.brevo.com:587 with STARTTLS;
# Gmail uses smtp.gmail.com:587 with an App Password and STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=ICMS
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_DELAY_SECONDS=0.5
LOG_LEVEL=INFO
LOG_FORMAT=plain
# Uvicorn trusts forwarded headers only from these proxy IPs. Never use "*"
# on an internet-reachable instance. Match this to the deployment topology.
FORWARDED_ALLOW_IPS=127.0.0.1
MEDIA_ROOT=uploads
CATTLE_MEDIA_MAX_BYTES=10485760
PROFILE_AVATAR_MAX_BYTES=5242880
# Backup encryption key: URL-safe base64 encoding of exactly 32 random bytes.
# Generate securely and keep an offline recovery copy; never commit the real value.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_ID=primary
BACKUP_ROOT=backups/encrypted
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
# Google OAuth web application credentials. Keep the secret server-side only.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/admin/backups/google/callback
GOOGLE_DRIVE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_TIMEOUT_SECONDS=30
