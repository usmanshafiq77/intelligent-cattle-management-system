APP_ENV=staging
DB_NAME=icms_staging
DB_USER=icms_app
DB_PASSWORD=replace-with-a-unique-staging-database-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=["http://localhost:8081"]
AUTH_RATE_LIMIT_ENABLED=true
EMAIL_DELIVERY_MODE=smtp
FRONTEND_PUBLIC_URL=http://localhost:8081
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-provider-approved-app-password
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_SENDER_EMAIL=sender@example.com
SMTP_SENDER_NAME=ICMS
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_DELAY_SECONDS=0.5
LOG_LEVEL=INFO
LOG_FORMAT=json
MEDIA_ROOT=/app/uploads
CATTLE_MEDIA_MAX_BYTES=10485760
FORWARDED_ALLOW_IPS=127.0.0.1
POSTGRES_BIND_PORT=5433
BACKEND_BIND_PORT=8000
FRONTEND_BIND_PORT=8081
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:8000
